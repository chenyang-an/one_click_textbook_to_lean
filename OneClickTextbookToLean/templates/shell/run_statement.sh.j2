#!/bin/bash
# run_statement.sh - Autonomous statement formalization and verification loop for Chapter {{ ch_num }}

# === Configuration ===
BASE_DIR="{{ experiment_ch_dir }}"
AGENT_DIR="$BASE_DIR/agent"
VERIFY_DIR="$BASE_DIR/verification_fl_statement"
LOG_DIR="$BASE_DIR/verification_fl_statement"

STATEMENT_FL_TASK="$AGENT_DIR/CLAUDE_statement_fl.md"
STATEMENT_VERIFY_TASK="$AGENT_DIR/CLAUDE_statement_verify.md"
VERDICT_TASK="$AGENT_DIR/CLAUDE_verdict_statement.md"

# Per-round paths are set inside the loop (ROUND_DIR, STATEMENTS_STATUS, STATEMENTS_FL_STATUS)

STATUS_FILE="$LOG_DIR/AUTO_RUN_STATUS.md"
LOG_FILE="$LOG_DIR/AUTO_RUN_LOG.txt"
WORKDIR="{{ project_root }}"

MAX_ITERATIONS={{ max_statement_iterations }}
CHECK_INTERVAL=1

cd "$WORKDIR"

# === Helper function to update status ===
update_status() {
    local iteration=$1
    local step=$2
    local state=$3
    local details=$4

    cat > "$STATUS_FILE" << EOF
# Chapter {{ ch_num }} Statement Formalization - Auto Status

| Field | Value |
|-------|-------|
| **Status** | $state |
| **Current Iteration** | $iteration / $MAX_ITERATIONS |
| **Current Step** | $step |
| **Started At** | $START_TIME |
| **Last Updated** | $(date '+%Y-%m-%d %H:%M:%S') |
| **PID** | $$ |

## Current Activity
$details

## Progress History
$(cat "$STATUS_FILE.history" 2>/dev/null || echo "No history yet")
EOF
}

# === Helper to append to history ===
append_history() {
    echo "- [$(date '+%H:%M:%S')] $1" >> "$STATUS_FILE.history"
}

# === Cleanup on exit ===
cleanup() {
    local exit_code=$?
    pkill -P $$ 2>/dev/null

    if [ $exit_code -eq 0 ]; then
        update_status "$CURRENT_ITER" "Completed" "FINISHED" "All verifications passed successfully!"
    elif [ $exit_code -eq 1 ]; then
        update_status "$CURRENT_ITER" "Stopped" "STOPPED" "Max iterations reached or manual stop."
    elif [ $exit_code -eq 130 ]; then
        update_status "$CURRENT_ITER" "Interrupted" "INTERRUPTED" "Process interrupted by user (Ctrl+C)."
    else
        update_status "$CURRENT_ITER" "Error" "ERROR" "Process terminated unexpectedly (exit code: $exit_code)"
    fi
    append_history "Process ended with exit code $exit_code"
}

trap 'exit 130' INT TERM
trap cleanup EXIT

# === Initialize ===
START_TIME=$(date '+%Y-%m-%d %H:%M:%S')
CURRENT_ITER=0
mkdir -p "$LOG_DIR"
echo "" > "$STATUS_FILE.history"
append_history "Chapter {{ ch_num }} Statement Formalization started"

log() {
    echo "$1" | tee -a "$LOG_FILE"
}

run_claude() {
    local prompt="$1"
    local tmpfile=$(mktemp)

    claude {{ claude_flags }} -p "$prompt" 2>&1 | tee "$tmpfile" | while IFS= read -r line; do
        local type=$(echo "$line" | jq -r '.type // empty' 2>/dev/null)
        case "$type" in
            assistant)
                echo "$line" | jq -r '.message.content[]? | select(.type == "tool_use") | ">>> Tool: \(.name)" + (if .name == "Bash" then " - " + (.input.command // "" | .[0:200]) else "" end)' 2>/dev/null
                ;;
            result)
                local result=$(echo "$line" | jq -r '.result // empty')
                local duration_ms=$(echo "$line" | jq -r '.duration_ms // 0')
                local duration_min=$((duration_ms / 60000))
                local duration_sec=$(( (duration_ms % 60000) / 1000 ))
                local cost=$(echo "$line" | jq -r '.total_cost_usd // "N/A"')
                echo "$result"
                echo "--- Stats: ${duration_min}m${duration_sec}s | \$${cost} ---"
                ;;
        esac
    done | tee -a "$LOG_FILE"

    rm -f "$tmpfile"
}

run_claude_capture() {
    local prompt="$1"
    local tmpfile=$(mktemp)

    claude {{ claude_flags }} -p "$prompt" > "$tmpfile" 2>&1

    cat "$tmpfile" | while IFS= read -r line; do
        local type=$(echo "$line" | jq -r '.type // empty' 2>/dev/null)
        case "$type" in
            result)
                local result=$(echo "$line" | jq -r '.result // empty')
                echo "$result"
                ;;
        esac
    done | tee -a "$LOG_FILE" >&2

    local result=$(grep '"type":"result"' "$tmpfile" 2>/dev/null | jq -r '.result // empty')
    rm -f "$tmpfile"
    echo "$result"
}

echo "" >> "$LOG_FILE"
log "============================================"
log "Chapter {{ ch_num }} Statement Formalization Started at $START_TIME"
log "============================================"

# === Main Loop ===
for i in $(seq 1 $MAX_ITERATIONS); do
    CURRENT_ITER=$i

    # --- Create round directory ---
    ROUND_DIR="$VERIFY_DIR/round_$i"
    mkdir -p "$ROUND_DIR"
    STATEMENTS_STATUS="$ROUND_DIR/fl_statements_verification_result.md"
    STATEMENTS_FL_STATUS="$ROUND_DIR/fl_statements_status.md"

    # Find the previous round's files (for statement FL to read)
    PREV_ROUND=$((i - 1))
    PREV_ROUND_DIR="$VERIFY_DIR/round_$PREV_ROUND"
    PREV_STATEMENTS_STATUS="$PREV_ROUND_DIR/fl_statements_verification_result.md"

    log ""
    log "========================================"
    log "=== ITERATION $i of $MAX_ITERATIONS ==="
    log "========================================"
    log "Round directory: $ROUND_DIR"
    append_history "Iteration $i started (round dir: round_$i)"

    # Step 1: Statement Formalization
    update_status "$i" "1/3 Statement Formalization" "RUNNING" "Running Claude statement formalization task..."
    append_history "Iteration $i: Statement formalization started"
    log "Iteration $i: Statement Formalization started"

    STATEMENT_FL_PROMPT="Load task from $STATEMENT_FL_TASK."
    if [ -f "$PREV_STATEMENTS_STATUS" ]; then
        STATEMENT_FL_PROMPT="$STATEMENT_FL_PROMPT Also read the PREVIOUS round's verification result from $PREV_STATEMENTS_STATUS, and focus on fixing any major discrepancies or coverage issues reported there."
    fi
    STATEMENT_FL_PROMPT="$STATEMENT_FL_PROMPT This is round $i. Save your verification efforts and status log to $STATEMENTS_FL_STATUS. IMPORTANT: Do NOT modify any file outside of this chapter. Ignore any errors or warnings that are not about this chapter."

    run_claude "$STATEMENT_FL_PROMPT"

    log "Iteration $i: Statement Formalization ends"
    append_history "Iteration $i: Statement formalization completed"

    # Step 2: Statement Verification
    update_status "$i" "2/3 Statement Verification" "RUNNING" "Running Claude statement verification task..."
    append_history "Iteration $i: Statement verification started"
    log "Iteration $i: Statement Verification started"

    run_claude "Load task from $STATEMENT_VERIFY_TASK and execute the verification. This is round $i. Write results to $STATEMENTS_STATUS. IMPORTANT: Do NOT modify any file outside of this chapter. Ignore any errors or warnings that are not about this chapter."

    log "Iteration $i: Statement Verification ends"
    append_history "Iteration $i: Statement verification completed"

    # Step 3: Verdict
    update_status "$i" "3/3 Checking Verdict" "RUNNING" "Claude is analyzing verification results..."
    append_history "Iteration $i: Checking verdict"
    log "Iteration $i: Checking verdict"

    VERDICT_OUTPUT=$(run_claude_capture "Load task from $VERDICT_TASK. The verification result for this round is at $STATEMENTS_STATUS. Read that file and execute the verdict. Reply with exactly one word: DONE or CONTINUE.")
    DECISION=$(echo "$VERDICT_OUTPUT" | tail -1)

    log "Iteration $i: Decision is $DECISION"
    append_history "Iteration $i: Decision = $DECISION"

    if [[ "$DECISION" == *"DONE"* ]]; then
        log "========================================"
        log "=== Chapter {{ ch_num }} Statement Formalization Complete ==="
        log "========================================"
        append_history "SUCCESS - All verifications passed"
        exit 0
    fi

    log ">>> Continuing to next iteration..."
    sleep 2
done

log "========================================"
log "=== MAX ITERATIONS REACHED ==="
log "========================================"
append_history "STOPPED - Max iterations reached"
exit 1
